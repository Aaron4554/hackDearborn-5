# Copy to .env and point this at the running backend.
#
# Start the backend first (see agent/README.md), then pick the value that
# matches where you run the app:
#   Web / iOS Simulator   http://localhost:8000
#   Android emulator      http://10.0.2.2:8000
#   Physical phone        http://<your-computer-LAN-IP>:8000   (same Wi-Fi, backend bound to 0.0.0.0)
#
# If you change PORT in agent/.env because 8000 is taken, change this to match.
#
# Restart the dev server after editing (`npx expo start -c`): EXPO_PUBLIC_* values
# are inlined at bundle time, so a running server will not pick up a new value.
EXPO_PUBLIC_AGENT_API_URL=http://localhost:8000