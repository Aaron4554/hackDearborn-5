# Copy to .env and point this at the running backend.
#
# Start the backend first, then pick the value that matches where you run the app:
#   Web / iOS Simulator   http://localhost:8010
#   Android emulator      http://10.0.2.2:8010
#   Physical phone        http://<your-computer-LAN-IP>:8010   (same Wi-Fi, backend bound to 0.0.0.0)
#
# Restart the dev server after editing (`npx expo start -c`): EXPO_PUBLIC_* values
# are inlined at bundle time, so a running server will not pick up a new value.
EXPO_PUBLIC_AGENT_API_URL=http://localhost:8010