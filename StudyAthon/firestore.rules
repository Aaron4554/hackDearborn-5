rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function pairId(firstUid, secondUid) {
      return firstUid < secondUid
        ? firstUid + '_' + secondUid
        : secondUid + '_' + firstUid;
    }

    match /users/{uid} {
      // These documents contain public friend lookup and ranking fields, but
      // clients may fetch a known UID only; they cannot list the user directory.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'tag', 'points', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.tag.matches('^[0-9]{4}$')
        && request.resource.data.points == 0
        && request.resource.data.createdAt == request.time;
      // Points and identity fields are server-owned after profile creation.
      allow update, delete: if false;
    }

    match /userPrivate/{uid} {
      // Names and study details are private, especially for younger students.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName', 'educationLevel', 'gradeLevel',
          'takesAdvancedClasses', 'age', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.educationLevel in [
          'k12', 'high_school', 'college', 'university', 'graduate', 'other'
        ]
        && (request.resource.data.educationLevel == 'k12'
          ? request.resource.data.gradeLevel is string
            && request.resource.data.gradeLevel.matches('^(K|[1-8])$')
            && request.resource.data.takesAdvancedClasses == null
          : request.resource.data.educationLevel == 'high_school'
            ? request.resource.data.gradeLevel is string
              && request.resource.data.gradeLevel.matches('^(9|10|11|12)$')
              && request.resource.data.takesAdvancedClasses is bool
            : request.resource.data.gradeLevel == null
              && request.resource.data.takesAdvancedClasses == null)
        && (request.resource.data.age == null
          || (request.resource.data.age is int
            && request.resource.data.age >= 5
            && request.resource.data.age <= 100))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /handles/{handleId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && handleId == getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameLower + '#' + getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.tag;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // Permit participants to check a deterministic request path before it exists.
      allow get: if signedIn() && (resource == null
        || resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'targetHandle', 'status', 'createdAt'
        ])
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && exists(/databases/$(database)/documents/handles/$(request.resource.data.targetHandle))
        && get(/databases/$(database)/documents/handles/$(request.resource.data.targetHandle)).data.uid == request.resource.data.toUid
        && !exists(/databases/$(database)/documents/friendships/$(pairId(
          request.resource.data.fromUid, request.resource.data.toUid
        )));

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'declined'
          || (existsAfter(/databases/$(database)/documents/friendships/$(pairId(
                resource.data.fromUid, resource.data.toUid
              )))
            && getAfter(/databases/$(database)/documents/friendships/$(pairId(
                 resource.data.fromUid, resource.data.toUid
               ))).data.memberUids.hasAll([
                 resource.data.fromUid, resource.data.toUid
               ])));

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      // Missing deterministic pair paths must be readable to check whether a
      // friendship already exists; existing friendship docs remain private to members.
      allow get: if signedIn() && (resource == null
        || request.auth.uid in resource.data.memberUids);
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberUids', 'requestId', 'createdAt'])
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdAt == request.time
        && friendshipId == pairId(
          request.resource.data.memberUids[0], request.resource.data.memberUids[1]
        )
        && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.memberUids
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid in request.resource.data.memberUids;
      allow update, delete: if false;
    }
  }
}
