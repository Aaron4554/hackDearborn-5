# Get a Gemini API key from Google AI Studio and copy this file to .env.
GOOGLE_API_KEY=replace-me
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by every agent. Default: gemini-3.8-flash
STUDYATHON_MODEL=gemini-3.8-flash

# Ingestion tuning.
# Questions generated per extracted concept.
STUDYATHON_QUESTIONS_PER_CONCEPT=2
# Upper bound on concepts pulled from one upload.
STUDYATHON_MAX_CONCEPTS=40
# Output ceiling for the question-writing stage. Raising it is the first thing to
# try if long uploads produce truncated (and therefore rejected) JSON.
STUDYATHON_WRITER_MAX_OUTPUT_TOKENS=65536

# Port for the FastAPI server.
PORT=8000
